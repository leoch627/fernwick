{
  "name": "v2board-xray-client",
  "version": "0.2.6",
  "private": true,
  "description": "V2Board + Xray 桌面客户端（开发版本）",
  "license": "UNLICENSED",
  "author": {
    "name": "Project maintainers"
  },
  "scripts": {
    "dev": "node --import tsx tools/develop.ts",
    "demo": "node --import tsx tools/develop.ts --demo",
    "preview:ui": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node tools/ui-smoke.mjs",
    "test:desktop": "cd desktop && go test -tags gtk3 -race ./...",
    "check:desktop": "cd desktop && go vet -tags gtk3 ./... && go test -tags gtk3 -race ./...",
    "fixtures:wails": "node --import tsx tools/wails-schema-fixtures.ts && node --import tsx tools/wails-compat-fixtures.ts",
    "fixtures:wails:check": "node --import tsx tools/wails-schema-fixtures.ts --check && node --import tsx tools/wails-compat-fixtures.ts --check",
    "build": "node --import tsx tools/build.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "config:check": "node --import tsx tools/config-check.ts",
    "brand": "node --import tsx tools/brand.ts",
    "release:check": "node --import tsx tools/release-check.ts",
    "sign": "node --import tsx tools/sign.ts",
    "package:test": "python3 tools/package.py",
    "package:release": "python3 tools/package.py",
    "schemas": "node --import tsx tools/export-schemas.ts",
    "test:core": "node tools/go-smoke.mjs core",
    "test:download": "node tools/go-smoke.mjs download",
    "rules:import": "python3 tools/import-rules.py",
    "core:fetch": "python3 tools/fetch-core.py",
    "native:build": "python3 tools/build-native.py",
    "package:windows": "python3 tools/package.py --target win32-x64",
    "package:macos": "python3 tools/package.py --target darwin-arm64 --target darwin-x64",
    "package:linux": "python3 tools/package.py --target linux-x64",
    "test:packaging": "python3 -m unittest discover -s tests -p \"packaging_test.py\"",
    "test:rules": "python3 -m unittest discover -s tests -p \"rules_test.py\""
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "semver": "7.7.3",
    "zod": "4.6.7",
    "@wailsio/runtime": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
