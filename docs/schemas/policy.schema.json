{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "policyVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "environment": {
      "type": "string",
      "enum": [
        "test",
        "production"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "test",
        "stable"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "notBefore": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "requiredCapabilities": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tun",
          "policy-schema-2"
        ]
      }
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "orderedIds": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "temporarilyDisabledIds": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "orderedIds",
        "temporarilyDisabledIds"
      ],
      "additionalProperties": false
    },
    "refresh": {
      "type": "object",
      "properties": {
        "subscriptionIntervalSec": {
          "type": "integer",
          "minimum": 300,
          "maximum": 21600
        },
        "accountIntervalSec": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "policyIntervalSec": {
          "type": "integer",
          "minimum": 300,
          "maximum": 3600
        },
        "maxSnapshotAgeSec": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400
        }
      },
      "required": [
        "subscriptionIntervalSec",
        "accountIntervalSec",
        "policyIntervalSec",
        "maxSnapshotAgeSec"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "expiryReminderDays": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "showTrafficSummary": {
          "type": "boolean"
        },
        "announcement": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "text": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "expiryReminderDays",
        "showTrafficSummary",
        "announcement"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "website": {
          "type": "string",
          "format": "uri"
        },
        "renew": {
          "type": "string",
          "format": "uri"
        },
        "help": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "website",
        "renew",
        "help"
      ],
      "additionalProperties": false
    },
    "nodeOperations": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "hiddenFromList": {
            "type": "boolean"
          },
          "eligibleForAuto": {
            "type": "boolean"
          },
          "disabledForConnection": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "nodeId",
          "hiddenFromList",
          "eligibleForAuto",
          "disabledForConnection"
        ],
        "additionalProperties": false
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "const": "cn-direct-default-proxy-v1"
        },
        "dnsTemplateId": {
          "type": "string",
          "const": "real-dns-split-v1"
        },
        "resource": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 33554432
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "id",
                "version",
                "url",
                "sha256",
                "bytes",
                "expiresAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "templateId",
        "dnsTemplateId",
        "resource"
      ],
      "additionalProperties": false
    },
    "maintenance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "startsAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "endsAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "platforms": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "win32",
                  "darwin",
                  "linux"
                ]
              }
            }
          },
          "required": [
            "reason",
            "startsAt",
            "endsAt",
            "platforms"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "update": {
      "type": "object",
      "properties": {
        "checkIntervalSec": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 86400
        },
        "noticeText": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "checkIntervalSec",
        "noticeText"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "productId",
    "environment",
    "channel",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "requiredCapabilities",
    "endpoints",
    "refresh",
    "ui",
    "links",
    "nodeOperations",
    "routing",
    "maintenance",
    "update"
  ],
  "additionalProperties": false
}
