{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "sections": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "direct",
              "proxy",
              "ai",
              "block"
            ]
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 520
            }
          },
          "ips": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sections"
  ],
  "additionalProperties": false
}
