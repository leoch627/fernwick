{
  // Update, rules and download endpoint for the desktop client. See server/README.md.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "v2board-client-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "v2board-client-files" }],
  // Re-sign the update index (24 h validity) and renew the policy when it nears expiry.
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): RELEASE_SIGNING_KEY, POLICY_SIGNING_KEY, ADMIN_TOKEN.
  // Optional var PUBLIC_ORIGIN when serving through a custom domain, e.g. "https://updates.example.net".
}
