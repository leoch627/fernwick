[Unit]
Description=V2Board desktop client update and telemetry endpoint
After=network-online.target
Wants=network-online.target

[Service]
# Edit both origins; put the signing key in /etc/v2board-endpoint/signing.pem (mode 600, owned by root).
# The API (:8787) only serves configuration and telemetry; the download domain (:8788) serves
# the download page and files. Drop -download-listen to serve both from one domain.
Environment=PUBLIC_ORIGIN=https://api.example.com
Environment=DOWNLOAD_ORIGIN=https://get.example.com
LoadCredential=signing.pem:/etc/v2board-endpoint/signing.pem
ExecStart=/usr/local/bin/v2board-endpoint -listen 127.0.0.1:8787 -download-listen 127.0.0.1:8788 -data /var/lib/v2board-endpoint -key-file ${CREDENTIALS_DIRECTORY}/signing.pem
DynamicUser=yes
StateDirectory=v2board-endpoint
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
