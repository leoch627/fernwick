# Caddy obtains and renews the certificate itself. List every domain that points at this
# server; the first one should match PUBLIC_ORIGIN in the systemd unit.
dl.example.com, dl.example.net {
	request_body {
		max_size 2GB
	}
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
	}
}
